<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 min-h-screen">

    <!-- Header -->
    <div class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">

            <div>
                <h1 class="text-4xl font-bold text-gray-800">
                    Student Management System
                </h1>

                <p class="text-gray-500 mt-1">
                    Manage student records efficiently
                </p>
            </div>

            <a
                href="/students/new"
                class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-6 py-3 rounded-xl font-semibold hover:scale-105 transition duration-300 shadow-lg"
            >
                + Add Student
            </a>

        </div>
    </div>

    <!-- Search Filter Sort -->
    <div class="max-w-7xl mx-auto px-6 mt-8">

        <form
            action="/students"
            method="GET"
            class="bg-white rounded-2xl shadow-lg p-5 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
        >

            <!-- Search -->
            <input
                type="text"
                name="search"
                value="<%= search || '' %>"
                placeholder="🔍 Search by Name"
                class="px-5 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition"
            >

            <!-- Course Filter -->
            <select
                name="course"
                class="px-5 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none"
            >

                <option value="">All Courses</option>

                <option value="B.Tech CSE" <%= course === "B.Tech CSE" ? "selected" : "" %>>
                    B.Tech CSE
                </option>

                <option value="B.Tech IT" <%= course === "B.Tech IT" ? "selected" : "" %>>
                    B.Tech IT
                </option>

                <option value="BCA" <%= course === "BCA" ? "selected" : "" %>>
                    BCA
                </option>

                <option value="MCA" <%= course === "MCA" ? "selected" : "" %>>
                    MCA
                </option>

                <option value="BBA" <%= course === "BBA" ? "selected" : "" %>>
                    BBA
                </option>

            </select>

            <!-- Sort -->
            <select
                name="sort"
                class="px-5 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none"
            >

                <option value="newest" <%= sort === "newest" ? "selected" : "" %>>
                    Newest First
                </option>

                <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>
                    Oldest First
                </option>

                <option value="nameAsc" <%= sort === "nameAsc" ? "selected" : "" %>>
                    Name (A → Z)
                </option>

                <option value="nameDesc" <%= sort === "nameDesc" ? "selected" : "" %>>
                    Name (Z → A)
                </option>

                <option value="ageAsc" <%= sort === "ageAsc" ? "selected" : "" %>>
                    Age (Low → High)
                </option>

                <option value="ageDesc" <%= sort === "ageDesc" ? "selected" : "" %>>
                    Age (High → Low)
                </option>

            </select>

            <!-- Buttons -->
            <div class="flex gap-3">

                <button
                    type="submit"
                    class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 rounded-xl font-semibold hover:scale-105 transition duration-300"
                >
                    Apply
                </button>

                <a
                    href="/students"
                    class="flex-1 bg-gray-300 text-gray-800 py-3 rounded-xl text-center font-semibold hover:bg-gray-400 transition duration-300"
                >
                    Clear
                </a>

            </div>

        </form>

    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-6 py-10">

        <% if (students.length === 0) { %>

            <div class="bg-white rounded-3xl shadow-xl p-12 text-center">

                <h2 class="text-3xl font-bold text-gray-700">
                    No Students Found
                </h2>

                <p class="text-gray-500 mt-3">
                    Try changing your search, filter, or sorting options.
                </p>

                <a
                    href="/students/new"
                    class="inline-block mt-6 bg-blue-600 text-white px-6 py-3 rounded-xl hover:bg-blue-700 transition"
                >
                    Add Student
                </a>

            </div>

        <% } else { %>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                <% students.forEach(student => { %>

                    <div class="bg-white rounded-3xl shadow-xl p-6 hover:-translate-y-2 hover:shadow-2xl transition duration-300">

                        <!-- Avatar -->
                        <div class="flex justify-center mb-5">

                            <div class="w-20 h-20 rounded-full bg-gradient-to-r from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold">
                                <%= student.name ? student.name.charAt(0).toUpperCase() : "?" %>
                            </div>

                        </div>

                        <!-- Student Info -->
                        <div class="text-center">

                            <h2 class="text-2xl font-bold text-gray-800">
                                <%= student.name %>
                            </h2>

                            <p class="text-gray-500 mt-2">
                                <%= student.course %>
                            </p>

                        </div>

                        <!-- Details -->
                        <div class="mt-6 space-y-2">

                            <p class="text-gray-700">
                                <span class="font-semibold">Age:</span>
                                <%= student.age %>
                            </p>

                            <p class="text-gray-700 break-all">
                                <span class="font-semibold">Email:</span>
                                <%= student.email %>
                            </p>

                        </div>

                        <!-- Buttons -->
                        <div class="mt-8 flex gap-2">

                            <a
                                href="/students/<%= student._id %>"
                                class="flex-1 text-center bg-blue-500 text-white py-2 rounded-xl hover:bg-blue-600 transition"
                            >
                                View
                            </a>

                            <a
                                href="/students/<%= student._id %>/edit"
                                class="flex-1 text-center bg-yellow-500 text-white py-2 rounded-xl hover:bg-yellow-600 transition"
                            >
                                Edit
                            </a>

                            <form
                                action="/students/<%= student._id %>?_method=DELETE"
                                method="POST"
                                class="flex-1"
                            >

                                <button
                                    type="submit"
                                    onclick="return confirm('Are you sure you want to delete this student?')"
                                    class="w-full bg-red-500 text-white py-2 rounded-xl hover:bg-red-600 transition"
                                >
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

</body>
</html>