<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-3xl">

        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

            <!-- Header -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-600 p-10 text-center">

                <div class="w-28 h-28 mx-auto rounded-full bg-white flex items-center justify-center text-5xl font-bold text-indigo-600">
                    <%= student.name.charAt(0).toUpperCase() %>
                </div>

                <h1 class="text-4xl font-bold text-white mt-5">
                    <%= student.name %>
                </h1>

                <p class="text-blue-100 text-lg mt-2">
                    <%= student.course %>
                </p>

            </div>

            <!-- Details -->
            <div class="p-8">

                <h2 class="text-2xl font-bold text-gray-800 mb-6">
                    Student Details
                </h2>

                <div class="grid md:grid-cols-2 gap-5">

                    <div class="bg-gray-100 rounded-2xl p-5">
                        <p class="text-gray-500">Age</p>
                        <p class="text-xl font-semibold">
                            <%= student.age %>
                        </p>
                    </div>

                    <div class="bg-gray-100 rounded-2xl p-5">
                        <p class="text-gray-500">Course</p>
                        <p class="text-xl font-semibold">
                            <%= student.course %>
                        </p>
                    </div>

                    <div class="bg-gray-100 rounded-2xl p-5 md:col-span-2">
                        <p class="text-gray-500">Email</p>
                        <p class="text-xl font-semibold break-all">
                            <%= student.email %>
                        </p>
                    </div>

                    <div class="bg-gray-100 rounded-2xl p-5 md:col-span-2">
                        <p class="text-gray-500">Student ID</p>
                        <p class="text-sm font-medium break-all">
                            <%= student._id %>
                        </p>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="flex gap-4 mt-8">

                    <a
                        href="/students"
                        class="flex-1 text-center bg-gray-300 py-3 rounded-xl font-semibold hover:bg-gray-400 transition"
                    >
                        Back
                    </a>

                    <a
                        href="/students/<%= student._id %>/edit"
                        class="flex-1 text-center bg-yellow-500 text-white py-3 rounded-xl font-semibold hover:bg-yellow-600 transition"
                    >
                        Edit
                    </a>

                    <form
                        action="/students/<%= student._id %>?_method=DELETE"
                        method="POST"
                        class="flex-1"
                    >
                        <button
                            type="submit"
                            class="w-full bg-red-500 text-white py-3 rounded-xl font-semibold hover:bg-red-600 transition"
                        >
                            Delete
                        </button>
                    </form>

                </div>

            </div>

        </div>

    </div>

</body>
</html>