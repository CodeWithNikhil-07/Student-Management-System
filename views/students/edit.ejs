<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-2xl">

        <!-- Header -->
        <div class="text-center mb-8">
            <h1 class="text-5xl font-bold text-gray-800">
                Student Management System
            </h1>

            <p class="text-gray-600 mt-3 text-lg">
                Update Student Information
            </p>
        </div>

        <!-- Form Card -->
        <div class="bg-white/80 backdrop-blur-lg shadow-2xl rounded-3xl p-8 border border-white">

            <div class="mb-6">
                <h2 class="text-3xl font-bold text-gray-800">
                    Edit Student
                </h2>

                <p class="text-gray-500 mt-2">
                    Modify the details and save changes.
                </p>
            </div>

            <form
                action="/students/<%= student._id %>?_method=PUT"
                method="POST"
                class="space-y-5"
            >

                <!-- Name -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">
                        Student Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= student.name %>"
                        autocomplete="name"
                        placeholder="Enter Student Name"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition duration-300"
                    >
                </div>

                <!-- Age -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">
                        Age
                    </label>

                    <input
                        type="number"
                        name="age"
                        value="<%= student.age %>"
                        min="1"
                        max="100"
                        placeholder="Enter Age"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition duration-300"
                    >
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">
                        Email Address
                    </label>

                    <input
                        type="email"
                        name="email"
                        value="<%= student.email %>"
                        autocomplete="email"
                        placeholder="Enter Email"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition duration-300"
                    >
                </div>

                <!-- Course -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">
                        Course
                    </label>

                    <select
                        name="course"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition duration-300"
                    >
                        <option value="B.Tech CSE" <%= student.course === "B.Tech CSE" ? "selected" : "" %>>
                            B.Tech CSE
                        </option>

                        <option value="B.Tech IT" <%= student.course === "B.Tech IT" ? "selected" : "" %>>
                            B.Tech IT
                        </option>

                        <option value="BCA" <%= student.course === "BCA" ? "selected" : "" %>>
                            BCA
                        </option>

                        <option value="MCA" <%= student.course === "MCA" ? "selected" : "" %>>
                            MCA
                        </option>

                        <option value="BBA" <%= student.course === "BBA" ? "selected" : "" %>>
                            BBA
                        </option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">

                    <a
                        href="/students"
                        class="w-1/2 text-center bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold hover:bg-gray-300 transition duration-300"
                    >
                        ← Back
                    </a>

                    <button
                        type="submit"
                        class="w-1/2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 rounded-xl font-semibold hover:scale-105 hover:shadow-xl transition duration-300"
                    >
                        Update Student
                    </button>

                </div>

            </form>

        </div>

    </div>

</body>
</html>