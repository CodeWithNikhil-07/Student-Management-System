<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 min-h-screen flex items-center justify-center p-6">

    <div class="w-full max-w-2xl">

        <!-- Heading -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-800">
                Student Management System
            </h1>

            <p class="text-gray-600 mt-2">
                Add and manage student records efficiently
            </p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-3xl shadow-2xl p-8">

            <div class="mb-6">
                <h2 class="text-2xl font-semibold text-gray-800">
                    Add New Student
                </h2>

                <p class="text-gray-500 text-sm mt-1">
                    Enter student details below
                </p>
            </div>

            <form action="/students" method="POST" class="space-y-5">

                <!-- Name -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Student Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        placeholder="Enter full name"
                        autocomplete="name"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition"
                    >
                </div>

                <!-- Age -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Age
                    </label>

                    <input
                        type="number"
                        name="age"
                        min="1"
                        max="100"
                        placeholder="Enter age"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition"
                    >
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Email Address
                    </label>

                    <input
                        type="email"
                        name="email"
                        placeholder="example@gmail.com"
                        autocomplete="email"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition"
                    >
                </div>

                <!-- Course -->
                <div>
                    <label class="block text-gray-700 font-medium mb-2">
                        Course
                    </label>

                    <select
                        name="course"
                        required
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-200 focus:border-blue-500 outline-none transition"
                    >
                        <option value="">Select Course</option>
                        <option>B.Tech CSE</option>
                        <option>B.Tech IT</option>
                        <option>BCA</option>
                        <option>MCA</option>
                        <option>BBA</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="flex gap-4 pt-4">

                    <a
                        href="/students"
                        class="w-1/2 text-center bg-gray-200 text-gray-700 py-3 rounded-xl font-semibold hover:bg-gray-300 transition duration-300"
                    >
                        ← Back
                    </a>

                    <button
                        type="submit"
                        class="w-1/2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-3 rounded-xl font-semibold text-lg hover:scale-[1.02] hover:shadow-xl transition duration-300"
                    >
                        ➕ Add Student
                    </button>

                </div>

            </form>

        </div>

    </div>

</body>
</html>